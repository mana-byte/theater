      "type": "object",
      "required": ["job_handles"],
      "properties": {
        "job_handles": {"type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true, "items": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"}},
