        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "additionalProperties": false
    },
    "participantListParams": {
      "type": "object",
      "properties": {
        "cursor": {"type": ["string", "null"], "maxLength": 2048},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "status": {"type": ["string", "null"], "maxLength": 128},
