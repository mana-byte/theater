      },
      "additionalProperties": false
    },
    "participantTransferParams": {
      "type": "object",
      "required": ["participants", "new_owner"],
      "properties": {
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": ["participant_id", "expected_revision"],
            "properties": {
              "participant_id": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
              "expected_revision": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          }
        },
        "new_owner": {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {"enum": ["local_operator", "participant"]},
            "participant_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 512}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "participant"}}},
              "then": {"required": ["participant_id"], "properties": {"participant_id": {"type": "string"}}},
              "else": {"properties": {"participant_id": {"type": "null"}}}
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "promptParams": {
      "type": "object",
      "required": ["participant_id", "prompt"],
      "properties": {
        "participant_id": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
