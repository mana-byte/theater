      "properties": {
        "since": {"type": ["number", "null"]},
        "participants": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "required": [
              "participant_id", "harness", "models", "input_tokens", "output_tokens",
              "cache_creation_input_tokens", "cache_read_input_tokens",
              "reasoning_output_tokens", "cost_microcents", "first_at", "last_at"
