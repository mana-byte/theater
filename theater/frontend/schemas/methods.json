      "properties": {
        "harness": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 16777216},
        "cwd": {"type": ["string", "null"], "maxLength": 4096},
        "approval": {"enum": ["manual", "edits", "yolo"]},
        "provider": {"type": ["string", "null"], "maxLength": 512},
        "workspace": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/jsonObject"},
        "model": {"type": ["string", "null"], "maxLength": 512},
        "reasoning_effort": {"type": ["string", "null"], "maxLength": 128},
