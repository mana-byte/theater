      "type": "object",
      "properties": {
        "since": {"type": ["number", "null"]},
        "participant_ids": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"}
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 500, "default": 500}
