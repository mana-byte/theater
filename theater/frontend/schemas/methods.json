          "$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/jsonObject",
          "properties": {
            "presence_invalidated": {
              "type": "boolean",
              "description": "True revokes cached provider presence and requests fresh inspection; it never asserts absence. Omitted or false leaves cached presence unchanged."
            }
          }
        }
      },
      "additionalProperties": false
    },
