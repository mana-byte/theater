      "type": "object",
      "required": ["segment_id"],
      "properties": {
        "segment_id": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
        "offset": {"type": "integer", "minimum": 0},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      },
      "additionalProperties": false
    },
    "trajectorySnapshotParams": {
      "type": "object",
      "required": ["participant_id"],
      "properties": {
        "participant_id": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
        "before": {"type": ["string", "null"], "maxLength": 4096},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      },
      "additionalProperties": false
