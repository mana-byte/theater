        "selector": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
        "kind": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
        "credential_verifier": {"type": "string", "minLength": 1, "maxLength": 4096},
        "capabilities": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"}},
        "limits": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/jsonObject"}
