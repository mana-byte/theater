      "type": "object",
      "required": ["namespace", "value"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "key": {"type": ["string", "null"], "maxLength": 128},
        "value": {"type": "string", "maxLength": 262144}
      },
      "additionalProperties": false
    },
    "scratchpadDeleteParams": {
      "type": "object",
      "required": ["namespace"],
      "properties": {
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128},
        "keys": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
        "clear": {"type": "boolean"}
