        "description": {"type": ["string", "null"], "maxLength": 4096}
      },
      "minProperties": 2,
      "additionalProperties": false
    },
    "participantStatusParams": {
      "type": "object",
      "required": ["participant_id", "status"],
      "properties": {
        "participant_id": {"$ref": "https://theater.dev/schemas/frontend/1.0/common.json#/$defs/identifier"},
